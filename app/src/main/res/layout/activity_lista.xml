<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtTituloLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_lista"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/purple_primary"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnAgregarSerie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/agregar_serie" />

        <TextView
            android:id="@+id/txtSerie1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/serie_stranger"
            android:textSize="17sp"
            android:padding="18dp"
            android:background="@color/white"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/btnDetalle1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ver_detalles" />

        <TextView
            android:id="@+id/txtSerie2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/serie_walking"
            android:textSize="17sp"
            android:padding="18dp"
            android:background="@color/white"
            android:layout_marginTop="15dp" />

        <Button
            android:id="@+id/btnDetalle2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ver_detalles" />

        <TextView
            android:id="@+id/txtSerie3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/serie_breaking"
            android:textSize="17sp"
            android:padding="18dp"
            android:background="@color/white"
            android:layout_marginTop="15dp" />

        <Button
            android:id="@+id/btnDetalle3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ver_detalles" />

    </LinearLayout>

</ScrollView>
