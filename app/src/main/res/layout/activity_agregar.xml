<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtTituloAgregar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_agregar"
            style="@style/TextoTitulo"
            android:gravity="center"
            android:layout_marginBottom="25dp" />

        <EditText
            android:id="@+id/edtNombreSerie"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/nombre_serie"
            android:inputType="textCapSentences"
            android:padding="12dp" />

        <EditText
            android:id="@+id/edtGeneroSerie"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/genero"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:layout_marginTop="15dp" />

        <EditText
            android:id="@+id/edtTemporadas"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/cantidad_temporadas"
            android:inputType="number"
            android:padding="12dp"
            android:layout_marginTop="15dp" />

        <EditText
            android:id="@+id/edtCapitulo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/ultimo_capitulo"
            android:inputType="text"
            android:padding="12dp"
            android:layout_marginTop="15dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/estado_serie"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <RadioGroup
            android:id="@+id/rgEstadoSerie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbEnEmision"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/en_emision" />

            <RadioButton
                android:id="@+id/rbFinalizada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/finalizada" />

            <RadioButton
                android:id="@+id/rbPausada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pausada" />

        </RadioGroup>

        <Button
            android:id="@+id/btnGuardarSerie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/guardar_serie"
            android:layout_marginTop="25dp" />

    </LinearLayout>

</ScrollView>

